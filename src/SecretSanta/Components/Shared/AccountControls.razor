@inject SantaService Santa
<nav class="account-controls" aria-label="Account">
    <AuthorizeView Context="auth">
        <Authorized>
            <div class="account-menu">
                <button class="account-menu-trigger" type="button" aria-label="Account menu">
                    @if (auth.User.FindFirstValue("avatar") is { } avatar)
                    {
                        <img class="account-avatar" src="@avatar" alt="" width="72" height="72"/>
                    }
                    else
                    {
                        <span>@(auth.User.Identity?.Name ?? "Account")</span>
                    }
                </button>
                <form class="account-menu-dropdown" method="post" action="/auth/logout">
                    <AntiforgeryToken/>
                    <button type="submit">Sign out</button>
                </form>
            </div>
            @if (Santa.IsAdmin(auth.User) && !ShowExchange)
            {
                <a class="account-link" href="/">Admin</a>
            }
            @if (ShowExchange)
            {
                <a class="account-link" href="/?view=exchange">My participation</a>
            }
        </Authorized>
        <NotAuthorized>
            <a class="present-button" href="/auth/login" aria-label="Sign in with Discord" title="Sign in with Discord"><span aria-hidden="true">🎁</span><span
                    class="present-label">Sign in</span></a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code { [Parameter] public bool ShowExchange { get; set; } }
